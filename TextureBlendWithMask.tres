[resource]
code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_lambert, specular_schlick_ggx;

uniform sampler2D Albedo;
uniform sampler2D BlendTexture;
uniform vec4 BlendColor : source_color = vec4(0.792157, 0.000000, 0.000000, 1.000000);
uniform sampler2D BlendMask;
uniform float blend : hint_range(0, 1, 0.10000000149012) = 0;



void fragment() {
// Input:10
	vec2 n_out10p0 = UV;


	vec4 n_out2p0;
// Texture2D:2
	n_out2p0 = texture(Albedo, n_out10p0);


	vec4 n_out16p0;
// Texture2D:16
	n_out16p0 = texture(BlendTexture, n_out10p0);


// ColorParameter:7
	vec4 n_out7p0 = BlendColor;


// VectorOp:18
	vec3 n_out18p0 = vec3(n_out16p0.xyz) * vec3(n_out7p0.xyz);


	vec4 n_out3p0;
// Texture2D:3
	n_out3p0 = texture(BlendMask, n_out10p0);


// FloatParameter:5
	float n_out5p0 = blend;


// FloatOp:15
	float n_in15p1 = 1.00000;
	float n_out15p0 = n_out5p0 * n_in15p1;


// VectorOp:9
	vec4 n_out9p0 = step(n_out3p0, vec4(n_out15p0));


// Mix:4
	vec4 n_out4p0 = mix(n_out2p0, vec4(n_out18p0, 0.0), n_out9p0.x);


// Output:0
	ALBEDO = vec3(n_out4p0.xyz);


}

[gd_resource type="Resource" script_class="EquipmentLayout" load_steps=9 format=3]

[ext_resource type="Script" path="res://core/equipment/equipment_slot_definition.gd" id="slot"]
[ext_resource type="Script" path="res://core/equipment/equipment_layout.gd" id="layout"]

[sub_resource type="Resource" id="Slot_head"]
script = ExtResource("slot")
id = &"head"
display_name = "Head"
max_size = 0
accepts_non_garment = false
excluded_from_auto_stow = false


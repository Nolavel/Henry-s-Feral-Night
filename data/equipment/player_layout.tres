[resource]
script = ExtResource("layout")
body_slots = [SubResource("Slot_head"), SubResource("Slot_torso"), SubResource("Slot_legs"), SubResource("Slot_feet"), SubResource("Slot_pack"), SubResource("Slot_fixture")]

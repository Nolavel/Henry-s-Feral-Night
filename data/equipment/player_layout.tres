script = ExtResource("slot")
id = &"torso"
display_name = "Torso"
max_size = 1
accepts_non_garment = false
excluded_from_auto_stow = false

[sub_resource type="Resource" id="Slot_legs"]
script = ExtResource("slot")
id = &"legs"
display_name = "Legs"
max_size = 1
accepts_non_garment = false
excluded_from_auto_stow = false

[sub_resource type="Resource" id="Slot_feet"]
script = ExtResource("slot")
id = &"feet"
display_name = "Feet"
max_size = 1
accepts_non_garment = false
excluded_from_auto_stow = false

[sub_resource type="Resource" id="Slot_pack"]
script = ExtResource("slot")
id = &"pack"

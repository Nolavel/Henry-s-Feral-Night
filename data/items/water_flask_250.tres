[gd_resource type="Resource" script_class="ItemResource" load_steps=4 format=3]

[ext_resource type="Script" path="res://core/items/item_resource.gd" id="item"]
[ext_resource type="Script" path="res://core/items/consumable_data.gd" id="consumable"]

[sub_resource type="Resource" id="drink"]
script = ExtResource("consumable")
hydration = 12.0
leaves_behind_id = &"water_flask_empty"

[resource]
script = ExtResource("item")
id = &"water_flask_250"
display_name = "Water flask"
weight = 0.45
max_stack = 1
size_class = 0
consumable = SubResource("drink")
water_capacity_ml = 1000
water_remaining_ml = 250

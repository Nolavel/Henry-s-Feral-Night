[gd_resource type="Resource" script_class="ItemResource" load_steps=5 format=3]

[ext_resource type="Script" path="res://core/items/item_resource.gd" id="item"]
[ext_resource type="Script" path="res://core/items/garment_data.gd" id="garment"]
[ext_resource type="Script" path="res://core/equipment/equipment_slot_definition.gd" id="slot"]

[sub_resource type="Resource" id="P_thigh_left"]
script = ExtResource("slot")
id = &"thigh_left"
display_name = "Left thigh pocket"
max_size = 0
accepts_non_garment = false
excluded_from_auto_stow = false

[sub_resource type="Resource" id="G_work_trousers"]
script = ExtResource("garment")
body_slot_id = &"legs"
pockets = [SubResource("P_thigh_left")]
insulation_c = 2.2
mesh_node_name = &""

[resource]
script = ExtResource("item")
id = &"work_trousers"
display_name = "Work trousers"
weight = 0.9
max_stack = 1
size_class = 1
garment = SubResource("G_work_trousers")

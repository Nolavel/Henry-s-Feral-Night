; Engine configuration file.
; Generated/maintained for Henry's Feral Night.
; Target editor: Godot 4.8 dev6 .NET (mono).
;
; Edit through Godot where practical. Do not dump ProjectSettings back into this file.

config_version=5

[application]

config/name="Henry`s Feral Night"
config/tags=[]
run/main_scene="res://experimental_location/scenes/Graciosa_Island_Terrain.tscn"
config/features=PackedStringArray("4.8", "C#", "Forward Plus")
run/max_fps=0.0
run/low_processor_mode_sleep_usec=6900.0
run/frame_delay_msec=0.0
boot_splash/fullsize=false
boot_splash/image="uid://7vujivcaksjj"
config/icon="res://icon.svg"
boot_splash/minimum_display_time=5000

[debug_draw_3d]

settings/addon_root_folder="res://addons/debug_draw_3d"

[autoload]

PlayerState="*res://core/player_state/player_state.gd"
InputSystems="*res://core/input/input_systems.gd"
SoundSystem="*res://core/audio/sound_system.gd"

[display]

window/size/viewport_width=1920.0
window/size/viewport_height=1080.0
window/size/mode=3
window/size/initial_position_type=1.0
window/size/initial_position="(0, 0)"
window/size/borderless=true
window/size/window_width_override=0.0
window/size/window_height_override=0.0
window/stretch/mode="viewport"
window/handheld/orientation=0.0
window/vsync/vsync_mode=1.0
mouse_cursor/custom_image_hotspot="(0, 0)"
mouse_cursor/tooltip_position_offset="(10, 10)"

[dotnet]

project/assembly_name="Henry`s Feral Night"
project/assembly_reload_attempts=3.0

[editor]

version_control/autoload_on_startup=true

[editor_plugins]

enabled=PackedStringArray("res://addons/terrain_3d/plugin.cfg")

[file_customization]

folder_colors={
"res://assets/": "yellow",
"res://autoloads/": "purple",
"res://components/": "orange",
"res://docs/": "blue",
"res://experimental_location/": "pink",
"res://garbage/": "red",
"res://levels/": "gray",
"res://scenes/": "green",
"res://scripts/": "orange",
"res://tests/": "pink"
}

[global_group]

interactables=""

[gui]

theme/custom_font="res://assets/fonts/IM Fell English SC/IMFellEnglishSC-Regular.ttf"

[importer_defaults]

animation_library={
"animation/import_rest_as_RESET": true,
"animation/trimming": true,
"fbx/allow_geometry_helper_nodes": true,
"nodes/import_as_skeleton_bones": true
}

[internationalization]

locale/translations=PackedStringArray("res://localization/strings.en.translation", "res://localization/strings.ru.translation")

[shader_globals]

snow_cover={
"type": "float",
"value": 0.5
}
frost_amount={
"type": "float",
"value": 0.3
}


window/handheld/orientation=0.0
window/vsync/vsync_mode=1.0
mouse_cursor/custom_image_hotspot="(0, 0)"
mouse_cursor/tooltip_position_offset="(10, 10)"

[dotnet]

project/assembly_name="Сrimson Flow"

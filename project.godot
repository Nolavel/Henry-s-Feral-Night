[application]

config/name="Henry`s Feral Night"
config/tags=[]
run/main_scene="res://tests/scenes/TestScene.tscn"
config/features=PackedStringArray("4.5", "C#", "Forward Plus")
run/max_fps=0.0
run/low_processor_mode_sleep_usec=6900.0
run/frame_delay_msec=0.0
config/icon="res://icon.svg"
boot_splash/minimum_display_time=0.0

[debug_draw_3d]

settings/addon_root_folder="res://addons/debug_draw_3d"

[display]

